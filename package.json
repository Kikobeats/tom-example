{
  "name": "tom-example",
  "description": "Example Tom microservice showing payments, subscriptions, email, and notification handlers.",
  "homepage": "https://github.com/Kikobeats/tom-example",
  "version": "0.0.0",
  "main": "index.js",
  "author": {
    "email": "josefrancisco.verdu@gmail.com",
    "name": "Kiko Beats",
    "url": "https://kikobeats.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kikobeats/tom-example.git"
  },
  "bugs": {
    "url": "https://github.com/Kikobeats/tom-example/issues"
  },
  "keywords": [
    "api",
    "demo",
    "email",
    "example",
    "microservice",
    "notifications",
    "payments",
    "stripe",
    "subscriptions",
    "tom"
  ],
  "dependencies": {
    "config": "latest",
    "express": "latest",
    "tom-microservice": "latest"
  },
  "devDependencies": {
    "coveralls": "latest",
    "finepack": "latest",
    "git-authors-cli": "latest",
    "git-dirty": "latest",
    "nano-staged": "latest",
    "nyc": "latest",
    "simple-git-hooks": "latest",
    "standard": "latest",
    "standard-markdown": "latest",
    "svr": "latest"
  },
  "engines": {
    "node": ">= 8"
  },
  "files": [
    "bin",
    "config",
    "tom.config.js"
  ],
  "scripts": {
    "clean": "rm -rf node_modules",
    "coveralls": "nyc report --reporter=text-lcov | coveralls",
    "dev": "TZ=UTC NODE_ENV=development svr bin/server-dev --port 1337",
    "lint": "standard-markdown && standard",
    "pretest": "npm run lint",
    "pretty": "prettier-standard index.js {core,test,bin,scripts}/**/*.js --single-quote --print-width 100",
    "start": "TZ=UTC NODE_ENV=production node bin/server",
    "test": "nyc mocha"
  },
  "license": "MIT",
  "nano-staged": {
    "*.js": [
      "git add",
      "prettier-standard"
    ],
    "*.md": [
      "git add",
      "standard-markdown"
    ],
    "package.json": [
      "finepack",
      "git add"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "nano-staged"
  }
}
